{
  "name": "shopfloor-order-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestration layer for robot shopfloors: ERP/MES order intake, task decomposition, dispatch to robot cells and VDA 5050 AMRs, idempotent edge-cloud sync.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:nats": "vitest run --config vitest.nats.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/service/main.js",
    "lab": "tsc -p tsconfig.build.json && node --disable-warning=ExperimentalWarning dist/lab/cli.js",
    "start:edge": "node --disable-warning=ExperimentalWarning dist/service/edgeMain.js"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
